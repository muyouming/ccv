# Ignore unnecessary files to reduce build context
.git
.gitignore
*.md
doc/
site/
test/
bin/*.o
lib/*.o
lib/.deps
lib/config.log
lib/config.status
**/*.pyc
**/__pycache__
**/*.so
**/*.a
!lib/libccv.a
docker-service/
.github/
*.log
*.pid
*.seed
*.pid.lock
node_modules/
.env
.venv
venv/
ENV/
.DS_Store
Thumbs.db